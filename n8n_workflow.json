          "conditions": [
            {
              "id": "condition-purchase",
              "leftValue": "={{ $json.prediction }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-purchase",
      "name": "判斷是否再購",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "fromEmail": "your-email@gmail.com",
        "toEmail": "your-email@gmail.com",
        "subject": "=🟢 再購預測結果：客戶預測會再購！",
