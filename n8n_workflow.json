        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ benevolence: $json.benevolence, integrity: $json.integrity, competence: $json.competence, trust: $json.trust }) }}",
        "options": {}
      },
      "id": "http-predict",
